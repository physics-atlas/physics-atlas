{
  "name": "sophie_scicom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:content && vite",
    "build:content": "node scripts/compile-concepts.mjs && node scripts/check-pages.mjs && node scripts/build-layout.mjs",
    "build": "npm run build:content && tsc -b && vite build",
    "lint": "oxlint",
    "validate": "npm run build:content && node scripts/validate-concepts.mjs",
    "test": "npm run build:content && vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "katex": "^0.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.5"
  }
}
